# =============================================================================
# Machine Learning Datasets & Large Data (Preserve directory structure via .gitkeep)
# =============================================================================
datasets/**
!datasets/
!datasets/**/
!datasets/**/.gitkeep
backend/datasets/**
!backend/datasets/
!backend/datasets/**/
!backend/datasets/**/.gitkeep

