# ---------------------------------------------------------------------------
# Database (Neon Postgres) - get this connection string from your Neon project
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-string
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Dataset paths (used by scripts/seed_demo_database.py and ml/ evaluators)
# ---------------------------------------------------------------------------
FACE_DATASET_TRAIN_DIR=datasets/face_dataset/Image_Train
FACE_DATASET_TEST_DIR=datasets/face_dataset/Image_Test
PLATE_DATASET_TRAIN_DIR=datasets/number_plate_dataset/train
PLATE_DATASET_TEST_DIR=datasets/number_plate_dataset/test

# ---------------------------------------------------------------------------
# Model paths / names (filled in as later milestones add real models)
# ---------------------------------------------------------------------------
FACE_MODEL_NAME=buffalo_l
YOLO_MODEL_PATH=models/yolov8n.pt
PLATE_DETECTOR_MODEL_PATH=models/plate_detector.pt

# ---------------------------------------------------------------------------
# Fusion / confidence thresholds (all tunable without touching code)
# ---------------------------------------------------------------------------
FACE_SIM_HIGH=0.55
FACE_SIM_LOW=0.35
PLATE_CONF_HIGH=0.85
PLATE_CONF_LOW=0.55
ID_MATCH_CONFIDENCE=0.99
FUSION_VERIFY_THRESHOLD=0.70
FUSION_REVIEW_THRESHOLD=0.40
